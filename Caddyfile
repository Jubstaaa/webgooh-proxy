# ── pixel-guess (pixelguessgame.com) — static SPA, no app server ──
# A Vite build served straight off disk. The ~1900 game images are NOT here:
# they come from the pixelguess Space CDN, which is why this directory is under
# a megabyte. CI rsyncs apps/web/dist into /opt/proxy/sites/pixelguess.
#
pixelguessgame.com {
	import access_log
	import cfonly
	tls /etc/caddy/certs/pixelguessgame.com.pem /etc/caddy/certs/pixelguessgame.com.key
	encode gzip zstd
	import secure_headers
	import static_security_headers
	root * /srv/pixelguess

	# Vite writes content-hashed filenames here, so they can be cached forever.
	# Deliberately no index.html fallback: a stale hash should 404 loudly rather
	# than return HTML with a 200 that then fails to parse as JavaScript.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# React Router owns routing, so any unknown path serves the shell. The
		# shell itself must always be revalidated, or a deploy leaves clients
		# holding an index.html that points at asset hashes that no longer exist.
		header Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

www.pixelguessgame.com {
	import access_log
	import cfonly
	tls /etc/caddy/certs/pixelguessgame.com.pem /etc/caddy/certs/pixelguessgame.com.key
	handle {
		redir https://pixelguessgame.com{uri} permanent
	}
}

# ── yasinrofcanin.com — Next static export, no app server ──
# The site prerenders entirely (no API routes, no server actions), so `next
# build` with output: "export" produces plain files and there is no container.
# Photographs are not here either — they come from the yasinrofcanin Space CDN.
#
# beta.yasinrofcanin.com is deliberately absent: it is a separate Payload app
# that stays on Vercel, reached through its own DNS record.
yasinrofcanin.com {
	import access_log
	import cfonly
	tls /etc/caddy/certs/yasinrofcanin.com.pem /etc/caddy/certs/yasinrofcanin.com.key
	encode gzip zstd
	import secure_headers
	import static_security_headers
	root * /srv/yasinrofcanin

	# Astro writes content-hashed filenames here, safe to cache forever.
	handle /_astro/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# The HTML must always be revalidated, or a deploy leaves clients holding
		# markup that references chunk hashes which no longer exist.
		header Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.yasinrofcanin.com {
	import access_log
	import cfonly
	tls /etc/caddy/certs/yasinrofcanin.com.pem /etc/caddy/certs/yasinrofcanin.com.key
	# Vercel answered 308 here; a canonical host redirect belongs at 301, which is
	# what the other migrated sites use.
	handle {
		redir https://yasinrofcanin.com{uri} permanent
	}
}

# ── beta.yasinrofcanin.com — Next static export, no app server ──
# This was a Payload CMS app on MongoDB. The CMS and the database are gone: the
# content was exported into the repo, so this is now plain prerendered files.
# Covered by the same *.yasinrofcanin.com origin certificate as the apex.
beta.yasinrofcanin.com {
	import access_log
	import cfonly
	tls /etc/caddy/certs/yasinrofcanin.com.pem /etc/caddy/certs/yasinrofcanin.com.key
	encode gzip zstd
	import secure_headers
	import static_security_headers
	root * /srv/yasinrofcanin-beta

	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# Loopback health check for the deploy workflows (Host: localhost -> ACW app).
http://localhost {
	reverse_proxy 127.0.0.1:3000
}

# Content-hashed filenames are safe to cache forever. The HTML never is: a
# deploy would otherwise leave clients holding markup that references chunk
# hashes which no longer exist.
(next_export_files) {
	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# ── metrics (Beszel) — system and container metrics, monitoring only ──
# Deliberately not named after the tool: swap Beszel out and the hostname stays
# true. flush_interval -1 because the hub pushes live updates over SSE.
metrics.webgooh.tech {
	# Cloudflare Access sits in front of this hostname and answers Let's Encrypt's
	# validation request with a login redirect, so a public certificate cannot be
	# issued here — which is why the old domain used a Cloudflare origin certificate
	# for the panels. Caddy's own CA holds the line until one exists for this domain;
	# swap this for `tls /etc/caddy/certs/webgooh.tech.pem …key` once it does.
	tls internal
	import access_log
	import cfonly
	encode gzip zstd
	import secure_headers

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Beszel logs people in from the header Access sets, but it cannot register
	# anyone: PocketBase discards an OIDC email unless the provider also sends
	# email_verified, Access never sends it, and that check is hard-coded, so the
	# OIDC path answers 400 with "email: cannot be blank". Rather than registering
	# every new person by hand, anyone Access allows who is not one of the accounts
	# below arrives as a single shared read-only identity. Adding someone to the
	# Access policy is then the only step there is.
	#
	# The list is not an access list — Access already decided that. It exists so
	# these three keep their own accounts, and with them their own alerts and admin
	# rights. Touch it to promote someone, never to let someone in.
	# Signing out inside the panel only clears its own browser session; the next
	# request is authenticated again from the header Access sets, which reads as a
	# logout button that does nothing. This ends the Cloudflare session instead,
	# which Cloudflare revokes across every application, and returns here — where
	# Access asks for a login.
	handle /_logout* {
		redir https://{host}/cdn-cgi/access/logout?returnTo=https%3A%2F%2F{host}%2F
	}

	# Beszel's document is passed through a template so a handful of lines can be
	# appended to it — see /opt/proxy/sites/beszel-shell/shell.html for why. Matching
	# on Accept rather than a path list catches every entry point the app has,
	# including deep links like /system/foo, without guessing at its routes.
	#
	# This internal route is what the template pulls the real document from, and is
	# listed first so the template's own subrequest cannot match @document and
	# recurse into itself.
	handle /__beszel_document {
		rewrite * /
		reverse_proxy 127.0.0.1:8090
	}

	@document {
		header Accept *text/html*
		not path /api/* /assets/* /static/* /__beszel_document* /_ /_/*
	}

	handle @document {
		root * /srv/beszel-shell
		rewrite * /shell.html
		templates
		file_server
	}

	# The named accounts come from the host's proxy.env (OPS_USER_n_EMAIL, the same keys
	# the Cronicle identity page uses), so the addresses never live in git. Exact,
	# case-sensitive match: Access sends the address lowercase, and anything else
	# falls through to the shared viewer. An unset key becomes a value no email can
	# equal, so a missing account matches nobody.
	@named_user {
		header Cf-Access-Authenticated-User-Email {$OPS_USER_1_EMAIL:ops-user-unset}
		header Cf-Access-Authenticated-User-Email {$OPS_USER_2_EMAIL:ops-user-unset}
		header Cf-Access-Authenticated-User-Email {$OPS_USER_3_EMAIL:ops-user-unset}
	}

	handle @named_user {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
			header_up Cf-Access-Authenticated-User-Email viewer@webgooh.tech
		}
	}
}

