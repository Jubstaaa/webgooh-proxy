# ── standup-mr remote (standup.ilkerbalcilar.com) — MCP connector for claude.ai ──
# One Bun container (/opt/standup-mr) serving OAuth, the connect page and /mcp.
# CF-only ingress matters here beyond hygiene: the app rate-limits by
# CF-Connecting-IP, which only Cloudflare may set. Covered by the existing
# *.ilkerbalcilar.com origin certificate.
standup.ilkerbalcilar.com {
	import access_log
	import cfonly
	tls /etc/caddy/certs/ilkerbalcilar.com.pem /etc/caddy/certs/ilkerbalcilar.com.key
	encode gzip zstd
	import secure_headers
	reverse_proxy 127.0.0.1:3007
}

# ── cron (Cronicle) — scheduled job dashboard ──
# Same conventions as metrics: generic hostname (swap the tool, keep the name),
# origin cert already covers *.webgooh.tech, noindex, CF-only ingress.
# flush_interval -1 because the UI streams live job updates over websockets.
cron.webgooh.tech {
	# Cloudflare Access sits in front of this hostname and answers Let's Encrypt's
	# validation request with a login redirect, so a public certificate cannot be
	# issued here — which is why the old domain used a Cloudflare origin certificate
	# for the panels. Caddy's own CA holds the line until one exists for this domain;
	# swap this for `tls /etc/caddy/certs/webgooh.tech.pem …key` once it does.
	tls internal
	import access_log
	import cfonly
	encode gzip zstd
	import secure_headers

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Cronicle cannot read an auth header, but its external_user_api hook forwards
	# whatever Cookie header it received to an endpoint of our choosing and logs in
	# whoever that endpoint names. So the identity is smuggled in as a cookie here.
	#
	# The whole Cookie header is replaced rather than appended to, which is the
	# point: a visitor cannot supply their own cf_email, because theirs is thrown
	# away and rebuilt from the header Access sets. Cronicle keeps its session in
	# the browser's local storage, not in a cookie, so nothing is lost by dropping
	# the originals.
	reverse_proxy 127.0.0.1:3012 {
		flush_interval -1
		header_up Cookie "cf_email={http.request.header.Cf-Access-Authenticated-User-Email}"
	}
}
